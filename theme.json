{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,

		"layout": {
			"contentSize": "1200px",
			"wideSize": "1400px"
		},

		"spacing": {
			"units": [ "%", "px", "em", "rem", "vh", "vw" ]
		},

		"color": {
			"palette": [
				{
					"name": "Primary",
					"slug": "primary",
					"color": "#1e3a8a"
				},
				{
					"name": "Secondary",
					"slug": "secondary",
					"color": "#9333ea"
				},
				{
					"name": "Accent",
					"slug": "accent",
					"color": "#f59e0b"
				},
				{
					"name": "Light",
					"slug": "light",
					"color": "#f3f4f6"
				}
			]
		},

		"typography": {
			"fluid": true,

			"fontFamilies": [
				{
					"fontFamily": "Poppins, sans-serif",
					"name": "Poppins",
					"slug": "poppins"
				}
			],

			"fontSizes": [
				{
					"name": "Small",
					"slug": "small",
					"size": "clamp(0.8rem, 1vw, 1rem)"
				},
				{
					"name": "Medium",
					"slug": "medium",
					"size": "clamp(1rem, 2vw, 1.25rem)"
				},
				{
					"name": "Large",
					"slug": "large",
					"size": "clamp(1.8rem, 4vw, 2.8rem)"
				}
			]
		},

		"useRootPaddingAwareAlignments": true
	},

	"styles": {
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--poppins)"
		},

		"blocks": {
			"core/button": {
				"border": {
					"radius": "8px"
				},
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "#ffffff"
				}
			},
			"core/heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--poppins)"
				}
			}
		}
	},

	"templateParts": [
		{
			"area": "header",
			"name": "header"
		},
		{
			"area": "footer",
			"name": "footer"
		}
	]
}